# Only reviewed source and the exact retained fixtures required by Rust tests.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!crates/
!crates/**
!contracts/
!contracts/agent-protocol/
!contracts/agent-protocol/examples/
!contracts/agent-protocol/examples/*.json
!conformance/
!conformance/scenarios/
!conformance/scenarios/parallel_approval_snapshot_round_trip.json
!conformance/scenarios/uncertain_unsafe_effect.json
!conformance/reference/
!conformance/reference/recordings/
!conformance/reference/recordings/2026-09-30-workflows/
!conformance/reference/recordings/2026-09-30-workflows/workflow-observations.json
!conformance/reference/recordings/2026-10-01-grants/
!conformance/reference/recordings/2026-10-01-grants/grant-observations.json
!conformance/reference/recordings/2026-10-01-lifecycle/
!conformance/reference/recordings/2026-10-01-lifecycle/lifecycle-observations.json
!spec/
!spec/**
!scripts/
!scripts/container_initialize_volume.sh
!scripts/container_snapshot.py

# Exclude private/generated material even inside an allowed source directory.
**/.git
**/.git/**
**/target
**/target/**
**/node_modules
**/node_modules/**
**/.env
**/.env.*
**/.b4run-data
**/.b4run-data/**
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.log
