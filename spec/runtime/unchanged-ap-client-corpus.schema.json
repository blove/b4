            "ControllerHttpError",
            "WorkerHttpError",
            "ZodError",
            "DOMException",
            "AbortError",
            "Error",
            "TypeError"
          ]
        },
        "error_code": {
          "enum": [
            "none",
            "authentication_required",
            "resource_unavailable",
            "thread_busy",
            "execution_error",
            "grant_required",
            "invalid_request",
            "no_run_in_flight",
            "thread_not_found",
            "run_cancelled",
            "run_in_flight"
          ]
        },
        "result_shape": {
          "enum": [
            "none",
            "route-outcome",
            "fixture-value",
            "void-null",
            "thread-id",
            "thread-metadata",
            "null",
            "deleted",
            "not-found",
            "interrupt-result",
            "pending-empty",
            "cancel-result",
            "frame-stream"
          ]
        },
        "frames": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "eof": {
          "type": "boolean"
        },
        "cut": {
          "enum": [
            "none",
            "viewer-return",
            "signal-abort"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "error_class": {
                "not": {
                  "const": "none"
                }
              },
              "result_shape": {
                "const": "none"
              },
              "frames": {
                "maxItems": 0
              },
              "eof": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "error_class": {
                "const": "none"
              },
              "error_code": {
                "const": "none"
              },
              "client_status": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "stream"
              }
            }
          },
          "then": {
            "properties": {
              "result_shape": {
                "const": "frame-stream"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "cut": {
                      "const": "none"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "eof": {
                      "const": true
                    }
                  }
                },
                "else": {
                  "properties": {
                    "eof": {
                      "const": false
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "frames": {
                "maxItems": 0
              },
              "eof": {
                "const": false
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "returned"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "cut": {
                      "const": "none"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "cut": {
                      "enum": [
                        "none",
                        "signal-abort"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
