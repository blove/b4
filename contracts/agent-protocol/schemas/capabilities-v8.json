        "required_once_deny",
        "trusted_known_id_recovery",
        "fenced_cancellation",
        "fenced_deletion",
        "automatic_recovery_scan",
        "always_permissions",
        "durable_event_replay",
        "native_live_chunks",
        "built_in_model_providers",
        "memory_candidates",
