    },
    "core_profile_frozen": {
      "$ref": "capabilities-v7.json#/properties/core_profile_frozen"
    },
    "runtime_version": {
      "$ref": "capabilities-v7.json#/properties/runtime_version"
    },
    "application": {
      "$ref": "capabilities-v7.json#/properties/application"
    },
    "execution": {
      "$ref": "capabilities-v7.json#/properties/execution"
    },
    "features": {
