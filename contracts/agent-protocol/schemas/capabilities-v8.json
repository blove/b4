{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities-v8.json",
  "title": "B4 narrow durable settled permission-thread deletion capability descriptor v8",
  "x-schema-id": "urn:b4:agent-protocol:native:capabilities-v8",
  "x-implementation-status": "authored-contract",
  "x-compatibility-status": "authored-native-operational-contract",
