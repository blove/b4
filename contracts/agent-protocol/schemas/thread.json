{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Authored native design input; compatibility with independently executed TypeScript is unverified.",
  "x-compatibility-status": "unverified",
  "$id": "thread.json",
  "title": "Native thread DTO",
  "x-implementation-status": "native-dto",
  "type": "object",
  "properties": {
    "thread_id": {
      "$ref": "opaque-id.json"
    },
    "created_at": {
      "type": "string",
      "description": "Timestamp supplied by caller; this DTO does not read a clock."
    },
    "updated_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "idle",
        "busy",
        "interrupted"
      ]
    }
  },
  "required": [
    "thread_id",
    "created_at",
    "updated_at",
    "metadata",
    "status"
  ],
  "additionalProperties": false,
  "x-schema-id": "urn:b4:agent-protocol:draft:thread"
}
